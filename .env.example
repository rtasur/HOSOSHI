# HOSOSHI local development environment
# Copy this file to .env. Never commit .env.
#
# These values are for local/internal development only.
# Use strong unique secrets before any external deployment.

POSTGRES_DB=hoshoshi
POSTGRES_USER=hoshoshi
POSTGRES_PASSWORD=hoshoshi_dev_password

NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=hoshoshi_neo4j_dev

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_TTL_MINUTES=120

CORS_ORIGIN=http://localhost:5173

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=123456

STORAGE_PATH=./data/uploads
