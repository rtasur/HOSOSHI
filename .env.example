# HOSOSHI local development environment
# Demo defaults are included for the local SIH prototype. Never commit a real .env.

POSTGRES_DB=hoshoshi
POSTGRES_USER=hoshoshi
POSTGRES_PASSWORD=hoshoshi_dev_password

NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=hoshoshi_neo4j_dev

# START-HOSOSHI.cmd generates strong random values when these are blank.
JWT_SECRET=
JWT_TTL_MINUTES=120

CORS_ORIGIN=http://localhost:5173

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=123456

STORAGE_PATH=/app/data/uploads

API_ENCRYPTION_ENABLED=true
API_ENCRYPTION_KEY=

VITE_API_BASE_URL=/api/v1
